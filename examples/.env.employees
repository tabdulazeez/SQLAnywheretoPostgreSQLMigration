# Example .env configuration for the employees table

# SQL Anywhere Connection
SQLANY_HOST=localhost
SQLANY_PORT=2638
SQLANY_DATABASE=demo_db
SQLANY_USER=dba
SQLANY_PASSWORD=sql

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=demo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Sync Configuration
SYNC_INTERVAL_SECONDS=30
SYNC_TABLE_NAME=employees
SYNC_PRIMARY_KEY=id
SYNC_TIMESTAMP_COLUMN=last_modified

# Logging
LOG_LEVEL=INFO
LOG_FILE=sync_service.log
