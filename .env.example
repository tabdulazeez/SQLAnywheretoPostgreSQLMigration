# SQL Anywhere Connection
SQLANY_HOST=localhost
SQLANY_PORT=2638
SQLANY_DATABASE=your_database
SQLANY_USER=your_user
SQLANY_PASSWORD=your_password

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Sync Configuration
SYNC_INTERVAL_SECONDS=30
SYNC_PARALLEL_TABLES=5
SYNC_CONFIG_FILE=tables_config.json

# Multi-Table Configuration Options:
# Option 1: Use JSON config file (recommended for 74 tables)
#   - Create tables_config.json with table definitions
#   - Set SYNC_CONFIG_FILE=tables_config.json

# Option 2: Comma-separated table names (simple, same config for all)
# SYNC_TABLES=employees,departments,customers,orders,products
# SYNC_PRIMARY_KEY=id
# SYNC_TIMESTAMP_COLUMN=last_modified

# Option 3: JSON in environment variable (for dynamic configuration)
# SYNC_TABLES_JSON=[{"name":"employees","primary_key":"id","timestamp_column":"last_modified"}]

# Legacy single table support (for backward compatibility)
# SYNC_TABLE_NAME=your_table_name
# SYNC_PRIMARY_KEY=id
# SYNC_TIMESTAMP_COLUMN=last_modified

# Logging
LOG_LEVEL=INFO
LOG_FILE=sync_service.log
